    {
        "id": "64aa2560ea8dc3f6",
        "type": "mqtt in",
        "z": "3fa938e8e6ea3dab",
        "name": "LabDrop topics",
        "topic": "labdrop-jack-4821/#",
        "qos": "1",
        "datatype": "auto",
        "broker": "ld_broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
