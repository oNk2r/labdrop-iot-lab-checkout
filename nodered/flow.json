    {
        "id": "4347737db26278c8",
        "type": "function",
        "z": "3fa938e8e6ea3dab",
        "name": "Route LabDrop messages",
        "func": "// LabDrop topics:\n// labdrop-jack-4821/equipment/<id>\n// labdrop-jack-4821/events\n// labdrop-jack-4821/status\n// labdrop-jack-4821/alerts\nconst root = \"labdrop-jack-4821/\";\nconst topic = String(msg.topic || \"\");\nif (!topic.startsWith(root)) return null;\n\nconst parts = topic.slice(root.length).split(\"/\");\nconst kind = parts[0];\nlet d = msg.payload;\n\n// Equipment/event messages from the ESP32 are JSON.\nif (kind === \"equipment\" || kind === \"events\") {\n    if (typeof d === \"string\") {\n        try { d = JSON.parse(d); }\n        catch (e) { node.warn(\"Invalid JSON on \" + topic); return null; }\n    }\n    if (!d || !d.id || !d.name) return null;\n}\n\nconst fmt = ts => {\n    const n = Number(ts);\n    const date = n > 0 ? new Date(n > 1e12 ? n : n * 1000) : new Date();\n    return date.toLocaleString(\"en-GB\", { hour12: false });\n};\n\nconst borrowedState = d =>\n    d && (d.borrowed === true ||\n          String(d.status || \"\").toLowerCase() === \"borrowed\");\n\nconst out = [null, null, null, null, null, null, null, null];\n\nif (kind === \"equipment\") {\n    // Dynamic registry: supports all 7 items and any future items.\n    let items = flow.get(\"items\") || {};\n    const borrowed = borrowedState(d);\n\n    items[String(d.id)] = {\n        ...d,\n        id: String(d.id),\n        name: String(d.name),\n        status: borrowed ? \"borrowed\" : \"available\",\n        by: borrowed ? (d.by || d.borrower || \"-\") : \"-\"\n    };\n    flow.set(\"items\", items);\n\n    const all = Object.values(items).sort(\n        (a, b) => String(a.name).localeCompare(String(b.name))\n    );\n    const borrowedCount = all.filter(i => i.status === \"borrowed\").length;\n\n    out[0] = {\n        payload: all.map(i => ({\n            Item: i.name,\n            Status: i.status === \"borrowed\" ? \"BORROWED\" : \"AVAILABLE\",\n            Borrower: i.status === \"borrowed\" ? (i.by || \"-\") : \"-\",\n            Updated: fmt(i.ts)\n        }))\n    };\n    out[1] = { payload: all.length - borrowedCount };\n    out[2] = { payload: borrowedCount };\n}\nelse if (kind === \"events\") {\n    const event = borrowedState(d) ? \"CHECKOUT\" : \"RETURN\";\n    let log = flow.get(\"log\") || [];\n\n    log.unshift({\n        Time: fmt(d.ts),\n        Item: d.name,\n        Event: event,\n        Student: d.by || d.borrower || \"-\"\n    });\n    log = log.slice(0, 10);\n    flow.set(\"log\", log);\n\n    let counts = flow.get(\"counts\") || {};\n    if (event === \"CHECKOUT\") {\n        counts[d.name] = (counts[d.name] || 0) + 1;\n    }\n    flow.set(\"counts\", counts);\n\n    out[3] = { payload: log };\n    out[4] = { topic: d.name, payload: Number(counts[d.name] || 0) };\n    out[5] = {\n        payload: [fmt(d.ts), d.name, event, d.by || d.borrower || \"-\"].join(\",\") + \"\\n\"\n    };\n}\nelse if (kind === \"status\") {\n    out[6] = { payload: String(d).trim().toLowerCase() };\n}\nelse if (kind === \"alerts\") {\n    out[7] = {\n        topic: \"LabDrop alert\",\n        payload: typeof d === \"string\" ? d : JSON.stringify(d)\n    };\n}\nelse {\n    return null;\n}\nreturn out;",
        "outputs": 8,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
